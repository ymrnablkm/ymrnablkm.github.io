---
import { site } from '../lib/site';

const year = new Date().getFullYear();
const social = site.social || [];
---

<footer class="border-t border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E]">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-text-muted dark:text-[#666666]">
        © {year} {site.name}. {site.copyright}
      </p>
      <p class="text-sm text-text-muted dark:text-[#666666]">
        {site.footerText}
      </p>
    </div>

    {(social.length > 0 || site.contact) && (
      <div class="mt-5 flex flex-wrap items-center justify-center gap-4 text-sm">
        {social.map((item) => (
          <a href={item.href} target="_blank" rel="noopener" class="text-text-secondary dark:text-[#A6A6A6] hover:text-primary transition-colors">
            {item.label}
          </a>
        ))}
        {site.contact && (
          <span class="text-text-muted dark:text-[#666666]">联系：{site.contact}</span>
        )}
      </div>
    )}

    {site.icp && (
      <p class="mt-4 text-center text-xs text-text-muted dark:text-[#666666]">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
          {site.icp}
        </a>
      </p>
    )}
  </div>
</footer>
