---
import type { CollectionEntry } from 'astro:content';
import { categoryBySlug } from '../lib/site';

interface Props {
  post: CollectionEntry<'posts'>;
  /** 是否显示置顶标识；不传时沿用旧字段 pinned 的行为 */
  showPinned?: boolean;
}

const { post, showPinned } = Astro.props;
const pinned = showPinned === undefined ? Boolean(post.data.pinned) : showPinned;
const category = post.data.category ? categoryBySlug(post.data.category) : undefined;

// 从正文中按出现顺序提取图片，最多 3 张；正文没有图片时回退到封面图
function extractBodyImages(body: string): string[] {
  if (!body) return [];
  const found: { index: number; src: string }[] = [];
  let match: RegExpExecArray | null = null;

  const markdownImage = /!\[[^\]]*\]\(\s*([^)\s]+)/g;
  while ((match = markdownImage.exec(body)) !== null) {
    found.push({ index: match.index, src: match[1] });
  }

  const htmlImage = /<img[^>]*\ssrc=["']([^"']+)["']/gi;
  while ((match = htmlImage.exec(body)) !== null) {
    found.push({ index: match.index, src: match[1] });
  }

  return found
    .sort((a, b) => a.index - b.index)
    .map((item) => item.src)
    .filter((src) => src && !src.startsWith('data:'))
    .slice(0, 3);
}

const bodyImages = extractBodyImages(post.body || '');
const coverImage = post.data.cover || '';
const visibleResources = post.data.resources.filter((item) => item.visible).length;
---

<article class="card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] overflow-hidden h-full">
  <a href={`/posts/${post.id}`} class="block group h-full flex flex-col">
    <div class="p-5 flex flex-col flex-1 sm:p-6">
      <h2 class="text-lg font-semibold text-text-primary dark:text-[#E5E6EB] mb-2 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
        {post.data.title}
      </h2>

      {post.data.description && (
        <p class="text-sm text-text-secondary dark:text-[#A6A6A6] line-clamp-3 leading-relaxed mb-4">
          {post.data.description}
        </p>
      )}

      <div class="mb-4">
        {bodyImages.length === 1 && (
          <div class="aspect-[16/9] overflow-hidden rounded-lg bg-surface-card dark:bg-[#121212]">
            <img
              src={bodyImages[0]}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              onerror="this.style.visibility='hidden'"
            />
          </div>
        )}

        {bodyImages.length === 2 && (
          <div class="grid grid-cols-2 gap-2">
            {bodyImages.map((src) => (
              <div class="aspect-[4/3] overflow-hidden rounded-lg bg-surface-card dark:bg-[#121212]">
                <img
                  src={src}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.style.visibility='hidden'"
                />
              </div>
            ))}
          </div>
        )}

        {bodyImages.length >= 3 && (
          <div class="grid grid-cols-3 gap-2">
            {bodyImages.map((src) => (
              <div class="aspect-square overflow-hidden rounded-lg bg-surface-card dark:bg-[#121212]">
                <img
                  src={src}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.style.visibility='hidden'"
                />
              </div>
            ))}
          </div>
        )}

        {bodyImages.length === 0 && coverImage && (
          <div class="aspect-[16/9] overflow-hidden rounded-lg bg-surface-card dark:bg-[#121212]">
            <img
              src={coverImage}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              onerror="this.style.visibility='hidden'"
            />
          </div>
        )}

        {bodyImages.length === 0 && !coverImage && (
          <div class="aspect-[16/9] rounded-lg border border-dashed border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#121212] flex flex-col items-center justify-center gap-1 text-text-muted dark:text-[#666666]">
            <span class="text-2xl leading-none">📄</span>
            <span class="text-xs">暂无配图</span>
          </div>
        )}
      </div>

      <div class="mt-auto flex items-center justify-between gap-2 flex-wrap text-xs text-text-muted dark:text-[#666666]">
        <div class="flex items-center gap-2 flex-wrap">
          {pinned && (
            <span class="px-2 py-0.5 rounded-full bg-red-50 text-red-500 dark:bg-red-500/10">置顶</span>
          )}
          {category && (
            <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary">
              {category.icon} {category.name}
            </span>
          )}
          <span>📅 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
          <span data-card-slug={post.id} class="card-view-count hidden">
            👁️ <span class="card-view-num">0</span>
          </span>
        </div>
        {visibleResources > 0 && <span class="text-primary">📦 {visibleResources} 个下载渠道</span>}
      </div>
    </div>
  </a>
</article>
