---
import { getCollection } from 'astro:content';
import { nav, navChildren, site } from '../lib/site';

const pages = (await getCollection('pages'))
  .filter((page) => page.data.showInNav && !page.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const extraLinks = pages
  .map((page) => ({ id: `page-${page.id}`, label: page.data.title, href: `/${page.id}`, external: false, order: 99, visible: true, parent: null }))
  .filter((page) => !nav.some((item) => item.href === page.href));

const items = [...nav, ...extraLinks];
---

<nav class="nav-glass fixed top-0 left-0 right-0 z-40 bg-white/85 dark:bg-[#121212]/85 border-b border-surface-border dark:border-[#333333]">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src={site.logo} alt={site.name} class="w-6 h-6" loading="eager" />
        <span class="text-xl font-bold text-primary">{site.name}</span>
      </a>

      <!-- 电脑端导航 -->
      <div class="hidden md:flex items-center gap-6">
        {items.map((item) => {
          const children = navChildren(item.id);
          return (
            <div class="relative group">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
                class="text-sm font-medium text-text-secondary dark:text-[#A6A6A6] hover:text-primary transition-colors inline-flex items-center gap-1"
              >
                {item.label}
                {children.length > 0 && <span class="text-[10px]">▾</span>}
              </a>
              {children.length > 0 && (
                <div class="absolute left-0 top-full pt-3 hidden group-hover:block">
                  <div class="min-w-[150px] rounded-lg border border-surface-border dark:border-[#333333] bg-white dark:bg-[#1E1E1E] shadow-lg p-2">
                    {children.map((child) => (
                      <a
                        href={child.href}
                        target={child.external ? '_blank' : undefined}
                        rel={child.external ? 'noopener' : undefined}
                        class="block px-3 py-2 text-sm rounded-md text-text-secondary dark:text-[#A6A6A6] hover:bg-surface-card dark:hover:bg-[#121212] hover:text-primary"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}

        <button
          id="themeToggle"
          class="p-2 rounded-lg text-text-secondary dark:text-[#A6A6A6] hover:bg-surface-card dark:hover:bg-[#1E1E1E] transition-colors"
          aria-label="切换主题"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>
      </div>

      <!-- 手机端按钮 -->
      <div class="flex md:hidden items-center gap-2">
        <button
          id="themeToggleMobile"
          class="p-2 rounded-lg text-text-secondary dark:text-[#A6A6A6]"
          aria-label="切换主题"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </button>
        <button id="navToggle" class="p-2 rounded-lg text-text-secondary dark:text-[#A6A6A6]" aria-label="打开菜单">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- 手机端菜单 -->
    <div id="navPanel" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-1">
        {items.map((item) => (
          <div>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
              class="block px-3 py-2 rounded-lg text-sm text-text-secondary dark:text-[#A6A6A6] hover:bg-surface-card dark:hover:bg-[#1E1E1E]"
            >
              {item.label}
            </a>
            {navChildren(item.id).map((child) => (
              <a
                href={child.href}
                target={child.external ? '_blank' : undefined}
                rel={child.external ? 'noopener' : undefined}
                class="block px-6 py-2 rounded-lg text-sm text-text-muted dark:text-[#666666] hover:bg-surface-card dark:hover:bg-[#1E1E1E]"
              >
                {child.label}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var panel = document.getElementById('navPanel');
    var toggle = document.getElementById('navToggle');
    toggle &&
      toggle.addEventListener('click', function () {
        panel && panel.classList.toggle('hidden');
      });
  })();
</script>
