---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map(post => post.data.category))];
  
  return categories.map(category => ({
    params: { name: category },
    props: { 
      category,
      posts: posts.filter(post => post.data.category === category)
        .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
    },
  }));
}

const { category, posts } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(allPosts.map(post => post.data.category))];
---

<Layout title={`分类: ${category}`}>
  <!-- 面包屑 -->
  <nav class="flex items-center gap-2 text-sm text-text-muted dark:text-[#666666] mb-6">
    <a href="/" class="hover:text-primary transition-colors">首页</a>
    <span>/</span>
    <a href="/categories" class="hover:text-primary transition-colors">分类归档</a>
    <span>/</span>
    <span class="text-text-secondary dark:text-[#A6A6A6]">{category}</span>
  </nav>
  
  <!-- 分类切换 -->
  <div class="flex flex-wrap gap-2 mb-8">
    {categories.map(cat => (
      <a 
        href={`/categories/${encodeURIComponent(cat)}`}
        class={`px-4 py-2 text-sm font-medium rounded-lg transition-all ${
          cat === category 
            ? 'bg-primary text-white' 
            : 'bg-surface-card dark:bg-[#1E1E1E] text-text-secondary dark:text-[#A6A6A6] hover:bg-surface-border dark:hover:bg-[#333333]'
        }`}
      >
        {cat}
      </a>
    ))}
  </div>
  
  <!-- 分类信息 -->
  <div class="flex items-center gap-4 mb-8">
    <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center">
      <span class="text-2xl">📁</span>
    </div>
    <div>
      <h1 class="text-2xl font-bold text-text-primary dark:text-[#E5E6EB]">{category}</h1>
      <p class="text-text-muted dark:text-[#666666]">共 {posts.length} 篇文章</p>
    </div>
  </div>
  
  <!-- 文章列表 -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.map(post => (
      <article class="card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag text-xs">{post.data.category}</span>
          {post.data.featured && (
            <span class="px-2 py-0.5 bg-primary/10 text-primary text-xs rounded">置顶</span>
          )}
        </div>
        <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-2 line-clamp-2 hover:text-primary transition-colors">
          <a href={`/posts/${post.id}`}>{post.data.title}</a>
        </h3>
        <p class="text-sm text-text-secondary dark:text-[#A6A6A6] line-clamp-2 mb-3">{post.data.description}</p>
        <div class="flex items-center justify-between">
          <div class="flex gap-1">
            {post.data.tags.slice(0, 2).map(tag => (
              <span class="px-2 py-0.5 text-xs bg-surface-border dark:bg-[#333333] text-text-muted dark:text-[#666666] rounded">#{tag}</span>
            ))}
          </div>
          <time class="text-xs text-text-muted dark:text-[#666666]">{new Date(post.data.pubDate).toLocaleDateString('zh-CN')}</time>
        </div>
      </article>
    ))}
  </div>
</Layout>