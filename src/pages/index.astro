---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function calcReadingTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}
---

<Layout title="首页">
  <!-- Hero 标题区 -->
  <header class="text-center mb-12 pt-8 pb-4">
    <h1 class="text-5xl font-bold mb-3 bg-gradient-to-r from-primary via-[#722ED1] to-primary bg-clip-text text-transparent">
      Aether Yard
    </h1>
    <p class="text-lg text-text-secondary dark:text-[#A6A6A6] mb-2">
      优质资源分享站
    </p>
    <p class="text-sm text-text-muted dark:text-[#666666]">
      共 {posts.length} 篇文章
    </p>
  </header>

  <!-- 文章列表 -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {posts.map(post => {
      const readingTime = calcReadingTime(post.body);
      return (
        <article class="card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] overflow-hidden">
          <a href={`/posts/${post.id}`} class="block group">
            {post.data.cover && (
              <div class="aspect-[16/9] overflow-hidden bg-surface-card dark:bg-[#1E1E1E]">
                <img
                  src={post.data.cover}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-6">
              <h2 class="text-lg font-semibold text-text-primary dark:text-[#E5E6EB] mb-2 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                {post.data.title}
              </h2>

              <div class="flex items-center gap-3 text-xs text-text-muted dark:text-[#666666] mb-3">
                <span>📅 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
                <span>·</span>
                <span>⏱️ {readingTime} 分钟</span>
              </div>

              {post.data.description && (
                <p class="text-sm text-text-secondary dark:text-[#A6A6A6] line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </div>
          </a>
        </article>
      );
    })}
  </div>

  <!-- 空状态 -->
  {posts.length === 0 && (
    <div class="text-center py-24">
      <div class="text-6xl mb-4">📝</div>
      <p class="text-text-secondary dark:text-[#A6A6A6] mb-2">还没有文章</p>
      <p class="text-sm text-text-muted dark:text-[#666666]">去后台发布第一篇吧</p>
    </div>
  )}
</Layout>
