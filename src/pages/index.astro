---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import HotRanking from '../components/HotRanking.astro';
import { getCollection } from 'astro:content';
import { site, home, categories } from '../lib/site';

const allPosts = await getCollection('posts');

// 首页只读取「首页置顶」；两个新字段都未写入时按旧 pinned 的原行为处理
const pinnedHome = (post: (typeof allPosts)[number]) => {
  const data = post.data;
  const hasNewFields = data.pinnedHome !== undefined || data.pinnedCategory !== undefined;
  return hasNewFields ? Boolean(data.pinnedHome) : Boolean(data.pinned);
};

const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    if (pinnedHome(a) !== pinnedHome(b)) return pinnedHome(a) ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const featuredPosts = (home.featured || [])
  .map((slug) => posts.find((post) => post.id === slug))
  .filter((post): post is (typeof posts)[number] => Boolean(post));

const modules = (home.modules || []).filter((item) => item.visible);
const latestModuleIndex = modules.findIndex((item) => item.type === 'latest');
const hotPosts = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  hotPinned: Boolean(post.data.hotPinned),
}));
const homeCategories = home.categories && home.categories.length
  ? categories.filter((item) => home.categories!.includes(item.slug))
  : categories;
const slides = (home.slides || []).filter((item) => item.visible && item.image);
const heroTitle = home.hero?.title || site.name;
const heroSubtitle = home.hero?.subtitle || site.subtitle;
---

<Layout title={site.seo.title || site.name} description={site.seo.description || site.description}>
  {/* 公告条 */}
  {home.announcement?.visible && home.announcement.text && (
    <div class="mb-6 rounded-card border border-primary/20 bg-primary/5 px-4 py-3 text-sm text-text-secondary dark:text-[#A6A6A6] flex items-start gap-2">
      <span class="text-primary">📢</span>
      {home.announcement.link ? (
        <a href={home.announcement.link} class="hover:text-primary transition-colors">{home.announcement.text}</a>
      ) : (
        <span>{home.announcement.text}</span>
      )}
    </div>
  )}

  {/* 首页头部 */}
  {home.hero?.visible && (
    <header class="relative text-center mb-10 pt-8 pb-6">
      {home.hero.image && (
        <div class="absolute inset-0 -z-10 rounded-card overflow-hidden opacity-20">
          <img src={home.hero.image} alt="" class="w-full h-full object-cover" />
        </div>
      )}
      <h1 class="sr-only">{heroTitle}</h1>
      <p class="text-lg text-text-secondary dark:text-[#A6A6A6] mb-2">{heroSubtitle}</p>
      {site.intro && <p class="text-sm text-text-muted dark:text-[#666666] max-w-2xl mx-auto">{site.intro}</p>}
      <p class="text-xs text-text-muted dark:text-[#666666] mt-3">
        共 {posts.length} 篇文章 · {categories.length} 个分类
      </p>
    </header>
  )}

  {/* 轮播图 */}
  {slides.length > 0 && (
    <section class="mb-10">
      <div class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory">
        {slides.map((slide) => (
          <a
            href={slide.link || '#'}
            class="snap-start shrink-0 w-[85%] sm:w-[60%] lg:w-[45%] rounded-card overflow-hidden border border-surface-border dark:border-[#333333] group"
          >
            <div class="aspect-[16/9] overflow-hidden">
              <img
                src={slide.image}
                alt={slide.title || '推荐'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            {slide.title && (
              <div class="px-4 py-3 text-sm font-medium text-text-primary dark:text-[#E5E6EB]">{slide.title}</div>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  {/* 首页模块 */}
  <div class="space-y-12">
    {modules.map((module, moduleIndex) => {
      if (module.type === 'latest') {
        const list = posts.slice(0, module.limit || 12);
        return (
          <>
            <section>
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB]">{module.title}</h2>
                <a href="/posts" class="text-sm text-primary hover:underline">查看全部 →</a>
              </div>
              {list.length === 0 ? (
                <div class="text-center py-16 text-text-muted dark:text-[#666666]">
                  <div class="text-5xl mb-3">📝</div>
                  <p>还没有文章</p>
                </div>
              ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {list.map((post) => <PostCard post={post} showPinned={pinnedHome(post)} />)}
                </div>
              )}
            </section>
            {moduleIndex === latestModuleIndex && hotPosts.length > 0 && <HotRanking posts={hotPosts} />}
          </>
        );
      }

      if (module.type === 'featured') {
        const list = (module.limit ? featuredPosts.slice(0, module.limit) : featuredPosts);
        if (list.length === 0) return null;
        return (
          <section>
            <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-4">{module.title}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {list.map((post) => <PostCard post={post} showPinned={pinnedHome(post)} />)}
            </div>
          </section>
        );
      }

      if (module.type === 'resources') {
        const list = posts.filter((post) => post.data.resources.some((item) => item.visible)).slice(0, module.limit || 6);
        if (list.length === 0) return null;
        return (
          <section>
            <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-4">{module.title}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {list.map((post) => <PostCard post={post} showPinned={pinnedHome(post)} />)}
            </div>
          </section>
        );
      }

      if (module.type === 'categories') {
        const shownCategories = homeCategories.slice(0, 8);
        const hasMoreCategories = homeCategories.length > 8;
        return (
          <section>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB]">{module.title}</h2>
              {hasMoreCategories && (
                <a href="/categories" class="text-sm text-primary hover:underline">查看全部分类 →</a>
              )}
            </div>
            <div class="flex flex-wrap justify-center gap-2 sm:gap-4">
              {shownCategories.map((category) => {
                const count = posts.filter((post) => post.data.category === category.slug).length;
                return (
                  <a
                    href={`/category/${category.slug}`}
                    class="card-hover flex w-[calc(25%_-_6px)] sm:w-[calc(25%_-_12px)] min-w-0 flex-col items-center gap-1.5 rounded-card border border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E] p-2.5 text-center sm:flex-row sm:gap-4 sm:p-5 sm:text-left"
                  >
                    <span class="text-2xl leading-none sm:text-3xl">{category.icon || '📁'}</span>
                    <span class="min-w-0 w-full sm:w-auto">
                      <span class="block text-xs font-medium text-text-primary dark:text-[#E5E6EB] break-words sm:text-base">
                        {category.name}
                      </span>
                      <span class="hidden text-xs text-text-muted dark:text-[#666666] line-clamp-1 sm:block">
                        {category.description || `${count} 篇文章`}
                      </span>
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        );
      }

      if (module.type === 'text') {
        return (
          <section>
            <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-3">{module.title}</h2>
            <p class="text-sm text-text-secondary dark:text-[#A6A6A6] whitespace-pre-wrap leading-relaxed">
              {module.text}
            </p>
          </section>
        );
      }

      if (module.type === 'links') {
        const links = module.links || [];
        if (links.length === 0) return null;
        return (
          <section>
            <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-3">{module.title}</h2>
            <div class="flex flex-wrap gap-3">
              {links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  class="px-4 py-2 rounded-lg border border-surface-border dark:border-[#333333] text-sm text-text-secondary dark:text-[#A6A6A6] hover:border-primary hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </section>
        );
      }

      return null;
    })}
    {latestModuleIndex === -1 && hotPosts.length > 0 && <HotRanking posts={hotPosts} />}
  </div>

  {home.footer && (
    <section class="mt-12 rounded-card border border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E] p-6">
      <p class="text-sm text-text-secondary dark:text-[#A6A6A6] whitespace-pre-wrap leading-relaxed">{home.footer}</p>
    </section>
  )}
</Layout>
