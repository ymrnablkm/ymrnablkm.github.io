---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 自动读取 content/posts/ 下所有 Markdown 文章
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="首页">
  <!-- 站点标题 -->
  <header class="mb-10 text-center">
    <h1 class="text-4xl font-bold text-text-primary dark:text-[#E5E6EB] mb-3">
      Aether Yard
    </h1>
    <p class="text-lg text-text-secondary dark:text-[#A6A6A6]">
      优质资源分享站
    </p>
  </header>

  <!-- 文章列表 -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {posts.map(post => (
      <article class="card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-6">
        <a href={`/posts/${post.id}`} class="block">
          <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-2 hover:text-primary transition-colors line-clamp-2">
            {post.data.title}
          </h2>
          <p class="text-sm text-text-muted dark:text-[#666666] mb-3">
            {new Date(post.data.date).toLocaleDateString('zh-CN')}
          </p>
          {post.data.description && (
            <p class="text-text-secondary dark:text-[#A6A6A6] line-clamp-3">
              {post.data.description}
            </p>
          )}
        </a>
      </article>
    ))}
  </div>

  <!-- 空状态 -->
  {posts.length === 0 && (
    <div class="text-center py-20">
      <p class="text-text-muted dark:text-[#666666]">还没有文章，去后台发布第一篇吧！</p>
    </div>
  )}
</Layout>
