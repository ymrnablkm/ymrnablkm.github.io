---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 获取所有文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = allPosts.filter(post => post.data.featured);
const regularPosts = allPosts.filter(post => !post.data.featured)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// 获取分类统计
const categories = [...new Set(allPosts.map(post => post.data.category))];
const categoryCounts = categories.map(cat => ({
  name: cat,
  count: allPosts.filter(post => post.data.category === cat).length
}));

// 热门文章（按时间排序取前5）
const hotPosts = regularPosts.slice(0, 5);
---

<Layout title="首页">
  <!-- 置顶文章区 -->
  {featuredPosts.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-xl">⭐</span>
        <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB]">置顶推荐</h2>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {featuredPosts.map(post => (
          <article class="card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-6 relative overflow-hidden">
            <div class="absolute top-4 right-4">
              <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-medium rounded-full">置顶</span>
            </div>
            
            <div class="mb-4">
              <span class="tag">{post.data.category}</span>
            </div>
            
            <h3 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-3 hover:text-primary transition-colors">
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
            </h3>
            
            <p class="text-text-secondary dark:text-[#A6A6A6] mb-4 line-clamp-2">{post.data.description}</p>
            
            <div class="flex items-center justify-between">
              <div class="flex gap-2">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class="px-2 py-1 text-xs bg-surface-border dark:bg-[#333333] text-text-muted dark:text-[#666666] rounded">#{tag}</span>
                ))}
              </div>
              <time class="text-sm text-text-muted dark:text-[#666666]">
                {new Date(post.data.pubDate).toLocaleDateString('zh-CN')}
              </time>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
  
  <!-- 主内容区 -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 左侧文章列表 -->
    <div class="lg:col-span-3">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-xl">📝</span>
        <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB]">最新文章</h2>
      </div>
      
      <div class="space-y-4">
        {regularPosts.map(post => (
          <article class="card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="tag text-xs">{post.data.category}</span>
                </div>
                
                <h3 class="text-lg font-semibold text-text-primary dark:text-[#E5E6EB] mb-2 hover:text-primary transition-colors">
                  <a href={`/posts/${post.id}`}>{post.data.title}</a>
                </h3>
                
                <p class="text-text-secondary dark:text-[#A6A6A6] text-sm line-clamp-2 mb-3">{post.data.description}</p>
                
                <div class="flex items-center justify-between">
                  <div class="flex gap-2">
                    {post.data.tags.slice(0, 2).map(tag => (
                      <span class="px-2 py-0.5 text-xs bg-surface-border dark:bg-[#333333] text-text-muted dark:text-[#666666] rounded">#{tag}</span>
                    ))}
                  </div>
                  <time class="text-xs text-text-muted dark:text-[#666666]">
                    {new Date(post.data.pubDate).toLocaleDateString('zh-CN')}
                  </time>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
      
      <!-- 分页 -->
      {regularPosts.length > 10 && (
        <div class="flex justify-center gap-2 mt-8">
          <button class="pagination-btn px-4 py-2 bg-surface-card dark:bg-[#1E1E1E] border border-surface-border dark:border-[#333333] rounded-lg text-sm">上一页</button>
          <button class="pagination-btn active px-4 py-2 rounded-lg text-sm">1</button>
          <button class="pagination-btn px-4 py-2 bg-surface-card dark:bg-[#1E1E1E] border border-surface-border dark:border-[#333333] rounded-lg text-sm">2</button>
          <button class="pagination-btn px-4 py-2 bg-surface-card dark:bg-[#1E1E1E] border border-surface-border dark:border-[#333333] rounded-lg text-sm">下一页</button>
        </div>
      )}
    </div>
    
    <!-- 右侧边栏 -->
    <aside class="lg:col-span-1 space-y-6">
      <!-- 分类列表 -->
      <div class="bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
        <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-4 flex items-center gap-2">
          <span>📁</span>
          <span>文章分类</span>
        </h3>
        <ul class="space-y-2">
          {categoryCounts.map(cat => (
            <li>
              <a href={`/categories/${encodeURIComponent(cat.name)}`} class="flex items-center justify-between py-2 px-3 hover:bg-surface-border dark:hover:bg-[#333333] rounded-lg transition-colors">
                <span class="text-sm text-text-secondary dark:text-[#A6A6A6]">{cat.name}</span>
                <span class="text-xs text-text-muted dark:text-[#666666] bg-surface-border dark:bg-[#333333] px-2 py-0.5 rounded">{cat.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- 热门文章 -->
      <div class="bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
        <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-4 flex items-center gap-2">
          <span>🔥</span>
          <span>热门文章</span>
        </h3>
        <ul class="space-y-3">
          {hotPosts.map((post, index) => (
            <li>
              <a href={`/posts/${post.id}`} class="flex items-start gap-3 p-2 hover:bg-surface-border dark:hover:bg-[#333333] rounded-lg transition-colors group">
                <span class={`w-6 h-6 flex items-center justify-center text-xs font-bold rounded ${index < 3 ? 'bg-primary text-white' : 'bg-surface-border dark:bg-[#333333] text-text-muted dark:text-[#666666]'}`}>
                  {index + 1}
                </span>
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-text-primary dark:text-[#E5E6EB] line-clamp-1 group-hover:text-primary transition-colors">{post.data.title}</span>
                  <span class="text-xs text-text-muted dark:text-[#666666]">{post.data.category}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- 网站公告 -->
      <div class="bg-gradient-to-br from-primary/10 to-primary/5 rounded-card border border-primary/20 p-5">
        <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-3 flex items-center gap-2">
          <span>📢</span>
          <span>网站公告</span>
        </h3>
        <p class="text-sm text-text-secondary dark:text-[#A6A6A6] leading-relaxed">
          欢迎访问资源分享博客！所有资源仅供学习交流使用，请勿用于商业用途。如有问题请在评论区反馈。
        </p>
      </div>
    </aside>
  </div>
</Layout>