---
import Layout from '../../layouts/Layout.astro';
import { getPostsByCategory, getCategories, posts, categories } from '../../data/posts';

export async function getStaticPaths() {
  const allCategories = getCategories();
  return allCategories.map(category => ({
    params: { name: category.name },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryPosts = getPostsByCategory(category.name);
const categoryColor = categories.find(c => c.name === category.name)?.color || '#3B82F6';
---

<Layout title={`分类: ${category.name}`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-10 animate-fade-in-up">
      <div class="flex items-center gap-4">
        <div 
          class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl text-white font-bold"
          style={{ backgroundColor: categoryColor }}
        >
          {category.name.charAt(0)}
        </div>
        <div>
          <h1 class="text-2xl font-bold text-text-primary">{category.name}</h1>
          <p class="text-text-dim">共 {categoryPosts.length} 个资源</p>
        </div>
      </div>
      
      <div class="flex flex-wrap gap-2">
        {getCategories().map(cat => (
          <a 
            key={cat.name}
            href={`/category/${encodeURIComponent(cat.name)}`}
            class={`px-4 py-2 text-sm font-medium rounded-lg transition-all ${
              cat.name === category.name 
                ? 'text-white' 
                : 'bg-bg-card border border-border text-text-secondary hover:border-primary'
            }`}
            style={cat.name === category.name ? { backgroundColor: cat.color } : {}}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
    
    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 animate-stagger">
      {categoryPosts.length === 0 ? (
        <div class="col-span-full text-center py-20">
          <div class="w-20 h-20 rounded-2xl bg-bg-card flex items-center justify-center mx-auto mb-4 text-4xl">
            📭
          </div>
          <p class="text-text-muted">该分类暂无资源</p>
        </div>
      ) : (
        categoryPosts.map(post => (
          <article key={post.id} class="card card-glow p-5 group">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-bg-elevated to-bg-card flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                📦
              </div>
              
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                  <span 
                    class="tag text-xs"
                    style={`background: ${post.categoryColor}15; color: ${post.categoryColor}; border-color: ${post.categoryColor}30;`}
                  >
                    {post.category}
                  </span>
                </div>
                
                <h3 class="font-semibold text-text-primary mb-1.5 line-clamp-1 group-hover:text-primary transition-colors">
                  <a href={`/posts/${post.id}`}>{post.title}</a>
                </h3>
                
                <p class="text-sm text-text-muted line-clamp-2 mb-2">{post.description}</p>
                
                <div class="flex items-center justify-between">
                  <div class="flex gap-1.5">
                    {post.tags.slice(0, 2).map(tag => (
                      <span key={tag} class="px-2 py-0.5 text-xs bg-bg-elevated rounded text-text-dim">
                        #{tag}
                      </span>
                    ))}
                  </div>
                  <span class="text-xs text-text-dim">{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
                </div>
              </div>
            </div>
          </article>
        ))
      )}
    </div>
  </div>
</Layout>
