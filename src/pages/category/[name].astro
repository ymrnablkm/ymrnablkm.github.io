---
import Layout from '../../layouts/Layout.astro';
import { getPostsByCategory, getCategories, posts } from '../../data/posts';

export async function getStaticPaths() {
  const categories = getCategories();
  return categories.map(category => ({
    params: { name: category },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryPosts = getPostsByCategory(category);
const allPosts = posts.filter(p => !p.isDraft);
---

<Layout title={`分类: ${category}`}>
  <div class="flex flex-col xl:flex-row gap-8">
    <div class="flex-1 min-w-0">
      <div class="mb-6">
        <h1 class="text-2xl font-semibold text-text-title mb-2">分类: {category}</h1>
        <p class="text-text-muted">共 {categoryPosts.length} 篇文章</p>
      </div>
      
      <div class="space-y-4">
        {categoryPosts.length === 0 ? (
          <p class="text-text-muted py-8 text-center bg-card border border-border rounded-[8px]">
            该分类暂无文章
          </p>
        ) : (
          categoryPosts.map(post => (
            <article key={post.id} class="bg-card border border-border rounded-[8px] p-4.5 card-hover">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <span class="inline-block px-2.5 py-1 text-xs font-medium text-primary bg-primary/10 rounded-[4px] mb-2">
                    {post.category}
                  </span>
                  <h3 class="text-base font-semibold text-text-title mb-1.5">
                    <a href={`/posts/${post.id}`} class="hover:text-primary transition-colors">
                      {post.title}
                    </a>
                  </h3>
                  <p class="text-sm text-text-body line-clamp-2">{post.description}</p>
                </div>
                <span class="text-xs text-text-muted whitespace-nowrap">
                  {new Date(post.pubDate).toLocaleDateString('zh-CN')}
                </span>
              </div>
              <div class="flex items-center gap-2 mt-2.5">
                {post.tags.map(tag => (
                  <span key={tag} class="text-xs px-2 py-0.5 bg-border/50 text-text-muted rounded-[4px]">
                    #{tag}
                  </span>
                ))}
              </div>
            </article>
          ))
        )}
      </div>
    </div>
    
    <aside class="w-full xl:w-72 flex-shrink-0">
      <div class="bg-card border border-border rounded-[8px] p-4.5 sticky top-20">
        <h3 class="font-semibold text-text-title mb-3.5">所有分类</h3>
        <ul class="space-y-1.5">
          {getCategories().map(cat => (
            <li key={cat}>
              <a href={`/category/${encodeURIComponent(cat)}`} class={`flex items-center justify-between px-3 py-2 rounded-[6px] transition-colors ${cat === category ? 'bg-primary text-white' : 'hover:bg-border/30'}`}>
                <span class="text-sm">{cat}</span>
                <span class="text-xs">
                  {allPosts.filter(p => p.category === cat).length}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</Layout>
