---
import Layout from '../../layouts/Layout.astro';
import { getCategories, posts } from '../../data/posts';

const categories = getCategories();
const allPosts = posts.filter(p => !p.isDraft);
---

<Layout title="全部分类" description="浏览所有资源分类">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Header -->
    <div class="text-center mb-12 animate-fade-in-up">
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">📁 资源分类</h1>
      <p class="text-text-muted">选择分类浏览相关资源</p>
    </div>
    
    <!-- Categories Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-16 animate-stagger">
      {categories.map(cat => {
        const count = allPosts.filter(p => p.category === cat.name).length;
        return (
          <a 
            key={cat.name}
            href={`/category/${encodeURIComponent(cat.name)}`}
            class="card card-glow p-6 text-center group"
          >
            <div 
              class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 transition-transform group-hover:scale-110"
              style={{ background: `${cat.color}20` }}
            >
              <span class="text-3xl">📦</span>
            </div>
            <h3 class="font-semibold text-text-primary mb-1">{cat.name}</h3>
            <p class="text-sm text-text-dim">{count} 个资源</p>
          </a>
        );
      })}
    </div>
    
    <!-- All Posts -->
    <section class="animate-fade-in-up" style="animation-delay: 0.3s;">
      <h2 class="text-xl font-bold text-text-primary mb-6 flex items-center gap-3">
        <div class="w-1 h-6 bg-gradient-to-b from-purple-500 to-pink-500 rounded-full"></div>
        <span>📦 全部资源</span>
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {allPosts.map(post => (
          <article key={post.id} class="card card-glow p-5 group">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-bg-elevated to-bg-card flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                📦
              </div>
              
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                  <span 
                    class="tag text-xs"
                    style={`background: ${post.categoryColor}15; color: ${post.categoryColor}; border-color: ${post.categoryColor}30;`}
                  >
                    {post.category}
                  </span>
                </div>
                
                <h3 class="font-semibold text-text-primary mb-1.5 line-clamp-1 group-hover:text-primary transition-colors">
                  <a href={`/posts/${post.id}`}>{post.title}</a>
                </h3>
                
                <p class="text-sm text-text-muted line-clamp-2 mb-2">{post.description}</p>
                
                <div class="flex items-center justify-between">
                  <div class="flex gap-1.5">
                    {post.tags.slice(0, 2).map(tag => (
                      <span key={tag} class="px-2 py-0.5 text-xs bg-bg-elevated rounded text-text-dim">
                        #{tag}
                      </span>
                    ))}
                  </div>
                  <span class="text-xs text-text-dim">{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
