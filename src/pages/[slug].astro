---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((page) => !page.data.draft)
    .map((page) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const updated = page.data.updated || page.data.date;
---

<Layout
  title={page.data.seoTitle || page.data.title}
  description={page.data.seoDescription || page.data.description}
  keywords={page.data.keywords}
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <nav class="flex items-center gap-2 text-sm text-text-muted dark:text-[#666666] mb-4">
        <a href="/" class="hover:text-primary transition-colors">首页</a>
        <span>/</span>
        <span class="text-text-secondary dark:text-[#A6A6A6]">{page.data.title}</span>
      </nav>
      <h1 class="text-3xl font-bold text-text-primary dark:text-[#E5E6EB] mb-3">{page.data.title}</h1>
      {page.data.description && (
        <p class="text-base text-text-secondary dark:text-[#A6A6A6]">{page.data.description}</p>
      )}
      {updated && (
        <p class="text-xs text-text-muted dark:text-[#666666] mt-3">
          更新于 {new Date(updated).toLocaleDateString('zh-CN')}
        </p>
      )}
    </header>

    <div class="bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-6 sm:p-8">
      <div class="markdown-body max-w-none">
        <Content />
      </div>
    </div>

    {page.id === 'about' && (
      <section class="mt-8 rounded-card border border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E] p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-text-primary dark:text-[#E5E6EB] mb-4 flex items-center gap-2">
          <span>📮</span>联系方式
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href="mailto:ymrnablkm@gmail.com"
            class="flex items-center gap-3 rounded-lg border border-surface-border dark:border-[#333333] px-4 py-3 text-sm text-text-secondary dark:text-[#A6A6A6] hover:border-primary hover:text-primary transition-colors"
          >
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 6.5 12 13l8.5-6.5"></path>
            </svg>
            <span class="min-w-0 break-all">ymrnablkm@gmail.com</span>
          </a>
          <a
            href="https://x.com/ymrnablkm"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 rounded-lg border border-surface-border dark:border-[#333333] px-4 py-3 text-sm text-text-secondary dark:text-[#A6A6A6] hover:border-primary hover:text-primary transition-colors"
          >
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"></path>
            </svg>
            <span class="min-w-0 break-all">@ymrnablkm</span>
          </a>
        </div>
      </section>
    )}
  </article>
</Layout>
