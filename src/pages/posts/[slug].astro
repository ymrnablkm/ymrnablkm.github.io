---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 所有文章按日期排序
const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// 当前文章索引
const currentIndex = allPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// 计算阅读时长
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// 生成目录
const headings = post.body?.match(/^#{1,3}\s+.+/gm) || [];
const tocItems = headings.map(h => {
  const level = h.match(/^#+/)?.[0]?.length || 1;
  const text = h.replace(/^#+\s+/, '');
  const id = text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
  return { level, text, id };
});
---

<Layout title={post.data.title} description={post.data.description} image={post.data.cover} type="article" date={post.data.date.toISOString()}>
  <!-- 面包屑导航 -->
  <nav class="flex items-center gap-2 text-sm text-text-muted dark:text-[#666666] mb-6">
    <a href="/" class="hover:text-primary transition-colors">首页</a>
    <span>/</span>
    <span class="text-text-secondary dark:text-[#A6A6A6] line-clamp-1">{post.data.title}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区 -->
    <article class="lg:col-span-3">
      <!-- 文章头部 -->
      <header class="mb-8">
        {post.data.cover && (
          <div class="mb-6 rounded-card overflow-hidden">
            <img
              src={post.data.cover}
              alt={post.data.title}
              class="w-full h-auto"
              loading="eager"
            />
          </div>
        )}
        <h1 class="text-3xl font-bold text-text-primary dark:text-[#E5E6EB] mb-4 leading-tight">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted dark:text-[#666666] mb-4">
          <span>📅 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
          <span>⏱️ 阅读 {readingTime} 分钟</span>
          <span>📝 {wordCount} 字</span>
        </div>
        {post.data.description && (
          <p class="text-lg text-text-secondary dark:text-[#A6A6A6] leading-relaxed">
            {post.data.description}
          </p>
        )}
      </header>

      <!-- 文章正文 -->
      <div class="bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-6 sm:p-8">
        <div class="markdown-body max-w-none">
          <Content />
        </div>
      </div>

      <!-- 上一篇 / 下一篇 -->
      {(prevPost || nextPost) && (
        <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a href={`/posts/${prevPost.id}`} class="card-hover block bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
              <p class="text-xs text-text-muted dark:text-[#666666] mb-1">← 上一篇</p>
              <p class="font-medium text-text-primary dark:text-[#E5E6EB] line-clamp-2">{prevPost.data.title}</p>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`/posts/${nextPost.id}`} class="card-hover block bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5 text-right">
              <p class="text-xs text-text-muted dark:text-[#666666] mb-1">下一篇 →</p>
              <p class="font-medium text-text-primary dark:text-[#E5E6EB] line-clamp-2">{nextPost.data.title}</p>
            </a>
          ) : <div />}
        </nav>
      )}

      <!-- 返回首页 -->
      <div class="mt-8 text-center">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors">
          <span>←</span>
          <span>返回首页</span>
        </a>
      </div>
    </article>

    <!-- 侧边栏 - 目录导航 -->
    <aside class="lg:col-span-1">
      {tocItems.length > 0 && (
        <div class="sticky top-24 bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
          <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-4 flex items-center gap-2 text-sm">
            <span>📑</span>
            <span>目录</span>
          </h3>
          <nav class="space-y-1">
            {tocItems.map(item => (
              <a
                href={`#${item.id}`}
                class={`toc-link text-text-secondary dark:text-[#A6A6A6] toc-h${item.level}`}
                data-toc-id={item.id}
              >
                {item.text}
              </a>
            ))}
          </nav>
        </div>
      )}
    </aside>
  </div>

  <!-- 目录高亮 + 标题锚点脚本 -->
  <script>
    // 给 Markdown 标题加上 id（如果没有的话）
    document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3').forEach(h => {
      if (!h.id) {
        const text = h.textContent || '';
        h.id = text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
      }
    });

    // 滚动时高亮当前目录项
    const tocLinks = document.querySelectorAll('[data-toc-id]');
    const headings = document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3');

    function updateActiveToc() {
      let current = '';
      const scrollPos = window.scrollY + 120;

      headings.forEach(h => {
        if (h.offsetTop <= scrollPos) {
          current = h.id;
        }
      });

      tocLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('data-toc-id') === current);
      });
    }

    window.addEventListener('scroll', updateActiveToc, { passive: true });
    updateActiveToc();
  </script>
</Layout>
