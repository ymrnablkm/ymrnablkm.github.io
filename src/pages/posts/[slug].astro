---
import Layout from '../../layouts/Layout.astro';
import { getPostById, getPosts } from '../../data/posts';

export async function getStaticPaths() {
  const posts = getPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = getPosts().filter(p => p.id !== post.id);
const relatedPosts = allPosts.filter(p => p.category === post.category).slice(0, 4);
---

<Layout title={post.title} description={post.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Header -->
    <header class="mb-10 animate-fade-in-up">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span 
          class="tag text-sm"
          style={`background: ${post.categoryColor}20; color: ${post.categoryColor}; border-color: ${post.categoryColor}40;`}
        >
          {post.category}
        </span>
        {post.isFeatured && <span class="tag">⭐ 置顶</span>}
      </div>
      
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">
        {post.title}
      </h1>
      
      <p class="text-lg text-text-muted mb-6">{post.description}</p>
      
      <div class="flex flex-wrap items-center gap-4 text-sm text-text-dim">
        <span class="flex items-center gap-2">
          <span>📅</span>
          <span>{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
        </span>
        {post.updatedDate && (
          <span class="flex items-center gap-2">
            <span>🔄</span>
            <span>更新于 {new Date(post.updatedDate).toLocaleDateString('zh-CN')}</span>
          </span>
        )}
      </div>
      
      <div class="flex flex-wrap gap-2 mt-4">
        {post.tags.map(tag => (
          <span key={tag} class="px-3 py-1 text-xs bg-bg-elevated rounded-lg text-text-dim">
            #{tag}
          </span>
        ))}
      </div>
    </header>
    
    <!-- Download Button -->
    <div class="card p-6 bg-gradient-to-r from-green-500/10 to-emerald-500/10 border-green-500/30 mb-10 animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-text-primary mb-1">📥 下载资源</h3>
          <p class="text-sm text-text-muted">点击下方按钮获取下载链接</p>
        </div>
        <a 
          href={post.downloadUrl} 
          class="btn-download"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>⬇️</span>
          <span>立即下载</span>
        </a>
      </div>
    </div>
    
    <!-- Content -->
    <div class="card p-8 mb-10 animate-fade-in-up" style="animation-delay: 0.2s;">
      <div class="prose prose-invert max-w-none">
        <div class="text-text-secondary leading-relaxed whitespace-pre-line">
          {post.content}
        </div>
      </div>
    </div>
    
    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="animate-fade-in-up" style="animation-delay: 0.3s;">
        <h2 class="text-xl font-bold text-text-primary mb-6 flex items-center gap-3">
          <div class="w-1 h-6 bg-gradient-to-b from-purple-500 to-pink-500 rounded-full"></div>
          <span>📚 相关资源</span>
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedPosts.map(related => (
            <article key={related.id} class="card card-glow p-4 group">
              <span 
                class="tag text-xs mb-3"
                style={`background: ${related.categoryColor}15; color: ${related.categoryColor}; border-color: ${related.categoryColor}30;`}
              >
                {related.category}
              </span>
              <h3 class="font-semibold text-text-primary mb-2 line-clamp-2 group-hover:text-primary transition-colors text-sm">
                <a href={`/posts/${related.id}`}>{related.title}</a>
              </h3>
              <p class="text-xs text-text-muted line-clamp-2 mb-2">{related.description}</p>
              <span class="text-xs text-text-dim">{new Date(related.pubDate).toLocaleDateString('zh-CN')}</span>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
