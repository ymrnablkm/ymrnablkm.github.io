---
import Layout from '../../layouts/Layout.astro';
import { getPostById, getPosts } from '../../data/posts';

export async function getStaticPaths() {
  const posts = getPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = getPosts().filter(p => p.id !== post.id);
const relatedPosts = allPosts
  .filter(p => p.category === post.category)
  .slice(0, 4);
---

<Layout title={post.title} description={post.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <header class="mb-8">
      <span 
        class="inline-block px-4 py-1.5 text-xs font-medium text-white rounded-full mb-4"
        style={{ backgroundColor: post.categoryColor }}
      >
        {post.category}
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold text-text-title mb-3">
        {post.title}
      </h1>
      <p class="text-text-body text-lg mb-4">{post.description}</p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted">
        <span>📅 {new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
        {post.updatedDate && (
          <span>🔄 更新于 {new Date(post.updatedDate).toLocaleDateString('zh-CN')}</span>
        )}
      </div>
      <div class="flex flex-wrap items-center gap-2 mt-4">
        {post.tags.map(tag => (
          <span key={tag} class="px-3 py-1 text-xs bg-bg-card text-text-muted rounded-lg">
            #{tag}
          </span>
        ))}
      </div>
    </header>
    
    <div class="bg-bg-card border border-border rounded-xl p-6 sm:p-8 mb-8">
      <div class="prose prose-lg max-w-none">
        <div class="text-text-body leading-relaxed whitespace-pre-line">
          {post.content}
        </div>
      </div>
    </div>
    
    <div class="bg-gradient-to-r from-success/10 to-green-500/10 border border-success/20 rounded-xl p-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-text-title mb-1">📥 下载地址</h3>
          <p class="text-sm text-text-muted">点击下方按钮获取资源</p>
        </div>
        <a 
          href={post.downloadUrl} 
          class="btn-download"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>⬇️</span>
          <span>立即下载</span>
        </a>
      </div>
    </div>
    
    {relatedPosts.length > 0 && (
      <section>
        <h2 class="text-lg font-semibold text-text-title mb-4 flex items-center gap-2">
          <span>📚</span>
          <span>相关资源</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedPosts.map(related => (
            <article key={related.id} class="bg-bg-card border border-border rounded-xl p-4 card-hover">
              <span 
                class="inline-block px-2 py-0.5 text-xs font-medium text-white rounded-full mb-2"
                style={{ backgroundColor: related.categoryColor }}
              >
                {related.category}
              </span>
              <h3 class="font-semibold text-text-title mb-1.5 line-clamp-2">
                <a href={`/posts/${related.id}`} class="hover:text-primary transition-colors">
                  {related.title}
                </a>
              </h3>
              <p class="text-xs text-text-body line-clamp-2 mb-2">{related.description}</p>
              <span class="text-xs text-text-muted">{new Date(related.pubDate).toLocaleDateString('zh-CN')}</span>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
