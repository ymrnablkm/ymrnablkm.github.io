---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { categoryBySlug, tagBySlug } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection('posts'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const category = post.data.category ? categoryBySlug(post.data.category) : undefined;
const resources = (post.data.resources || []).filter((item) => item.visible && item.url);

const headings = post.body?.match(/^#{1,3}\s+.+/gm) || [];
const tocItems = headings.map((h) => {
  const level = h.match(/^#+/)?.[0]?.length || 1;
  const text = h.replace(/^#+\s+/, '');
  const id = text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
  return { level, text, id };
});


---

<Layout
  title={post.data.seoTitle || post.data.title}
  description={post.data.seoDescription || post.data.description}
  image={post.data.cover}
  keywords={post.data.keywords}
  type="article"
  date={post.data.date.toISOString()}
  noindex={post.data.draft}
>
  <!-- 面包屑导航 -->
  <nav class="flex items-center gap-2 text-sm text-text-muted dark:text-[#666666] mb-6 flex-wrap">
    <a href="/" class="hover:text-primary transition-colors">首页</a>
    <span>/</span>
    {category && (
      <>
        <a href={`/category/${category.slug}`} class="hover:text-primary transition-colors">{category.name}</a>
        <span>/</span>
      </>
    )}
    <span class="text-text-secondary dark:text-[#A6A6A6] line-clamp-1">{post.data.title}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <article class="lg:col-span-3">
      <header class="mb-8">
        <!-- 注入文章 slug 给前端脚本 -->
        <span data-post-slug={post.id} style="display:none" aria-hidden="true"></span>
        {post.data.cover && (
          <div class="mb-6 rounded-card overflow-hidden">
            <img src={post.data.cover} alt={post.data.title} class="w-full h-auto" loading="eager" />
          </div>
        )}
        {post.data.pinned && <span class="badge-pin">置顶</span>}
        <h1 class="text-3xl font-bold text-text-primary dark:text-[#E5E6EB] mb-2 leading-tight">
          {post.data.title}
        </h1>
        {post.data.subtitle && (
          <p class="text-base text-text-secondary dark:text-[#A6A6A6] mb-4">{post.data.subtitle}</p>
        )}
        <div class="flex flex-wrap items-center gap-4 text-sm text-text-muted dark:text-[#666666] mb-4">
          <span>📅 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
          <span id="post-view-count-wrap" class="hidden">
            👁️ <span id="post-view-count">0</span> 次浏览
          </span>
          {post.data.author && <span>✍️ {post.data.author}</span>}
        </div>
        {post.data.description && (
          <p class="text-lg text-text-secondary dark:text-[#A6A6A6] leading-relaxed">{post.data.description}</p>
        )}
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {post.data.tags.map((slug) => {
              const tag = tagBySlug(slug);
              return (
                <a
                  href={`/tag/${slug}`}
                  class="text-xs px-3 py-1 rounded-full bg-surface-card dark:bg-[#1E1E1E] border border-surface-border dark:border-[#333333] text-text-secondary dark:text-[#A6A6A6] hover:border-primary hover:text-primary transition-colors"
                >
                  #{tag?.name || slug}
                </a>
              );
            })}
          </div>
        )}
      </header>

      <div class="bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-6 sm:p-8 mb-8">
        <div class="markdown-body max-w-none">
          <Content />
        </div>
      </div>

      <!-- 资源下载区 -->
      {resources.length > 0 && (
        <section class="mb-8 rounded-card border border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E] p-5 sm:p-6">
          <h2 class="text-lg font-semibold text-text-primary dark:text-[#E5E6EB] mb-4 flex items-center gap-2">
            <span>📦</span>资源下载
          </h2>
          <div class="space-y-4">
            {resources.map((resource) => {
              const details = [
                resource.type ? `类型：${resource.type}` : '',
                resource.version ? `版本：${resource.version}` : '',
                resource.size ? `大小：${resource.size}` : '',
                resource.platform ? `平台：${resource.platform}` : '',
                resource.language ? `语言：${resource.language}` : '',
                resource.updated ? `更新：${resource.updated}` : '',
              ].filter(Boolean);
              return (
                <div class="rounded-lg border border-surface-border dark:border-[#333333] p-4">
                  <div class="flex items-start justify-between gap-3 flex-wrap">
                    <div class="min-w-0">
                      <h3 class="font-medium text-text-primary dark:text-[#E5E6EB]">{resource.name}</h3>
                      {resource.summary && (
                        <p class="text-sm text-text-secondary dark:text-[#A6A6A6] mt-1">{resource.summary}</p>
                      )}
                    </div>
                    {resource.channel && (
                      <span class="text-xs px-2 py-1 rounded bg-primary/10 text-primary shrink-0">{resource.channel}</span>
                    )}
                  </div>

                  {details.length > 0 && (
                    <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-1.5 text-xs text-text-muted dark:text-[#666666]">
                      {details.map((item) => <span>{item}</span>)}
                    </div>
                  )}

                  <div class="mt-4 flex flex-wrap items-center gap-3">
                    <a href={resource.url} target="_blank" rel="noopener" class="download-btn">
                      ⬇ {resource.buttonText || '立即下载'}
                    </a>
                    {resource.code && <span class="text-xs text-text-secondary dark:text-[#A6A6A6]">提取码：<strong>{resource.code}</strong></span>}
                    {resource.password && <span class="text-xs text-text-secondary dark:text-[#A6A6A6]">解压密码：<strong>{resource.password}</strong></span>}
                  </div>

                  {resource.instructions && (
                    <p class="mt-3 text-xs text-text-muted dark:text-[#666666] whitespace-pre-wrap">{resource.instructions}</p>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      )}

      {(prevPost || nextPost) && (
        <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a href={`/posts/${prevPost.id}`} class="card-hover block bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
              <p class="text-xs text-text-muted dark:text-[#666666] mb-1">← 上一篇</p>
              <p class="font-medium text-text-primary dark:text-[#E5E6EB] line-clamp-2">{prevPost.data.title}</p>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`/posts/${nextPost.id}`} class="card-hover block bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5 text-right">
              <p class="text-xs text-text-muted dark:text-[#666666] mb-1">下一篇 →</p>
              <p class="font-medium text-text-primary dark:text-[#E5E6EB] line-clamp-2">{nextPost.data.title}</p>
            </a>
          ) : <div />}
        </nav>
      )}

      <div class="mt-8 text-center">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors">
          <span>←</span>
          <span>返回首页</span>
        </a>
      </div>
    </article>

    <aside class="lg:col-span-1">
      {tocItems.length > 0 && (
        <div class="sticky top-24 bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5">
          <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-4 flex items-center gap-2 text-sm">
            <span>📑</span>
            <span>目录</span>
          </h3>
          <nav class="space-y-1">
            {tocItems.map((item) => (
              <a
                href={`#${item.id}`}
                class={`toc-link text-text-secondary dark:text-[#A6A6A6] toc-h${item.level}`}
                data-toc-id={item.id}
              >
                {item.text}
              </a>
            ))}
          </nav>
        </div>
      )}
    </aside>
  </div>

  <script>
    document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3').forEach((h) => {
      if (!h.id) {
        const text = h.textContent || '';
        h.id = text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
      }
    });

    const tocLinks = document.querySelectorAll('[data-toc-id]');
    const headings = document.querySelectorAll('.markdown-body h1, .markdown-body h2, .markdown-body h3');

    function updateActiveToc() {
      let current = '';
      const scrollPos = window.scrollY + 120;
      headings.forEach((h) => {
        if (h.offsetTop <= scrollPos) current = h.id;
      });
      tocLinks.forEach((link) => {
        link.classList.toggle('active', link.getAttribute('data-toc-id') === current);
      });
    }

    window.addEventListener('scroll', updateActiveToc, { passive: true });
    updateActiveToc();

    // 浏览量统计：localStorage 即时显示 + 后台异步更新
    (function () {
      var slugEl = document.querySelector('[data-post-slug]');
      var slug = slugEl ? slugEl.getAttribute('data-post-slug') : '';
      var wrap = document.getElementById('post-view-count-wrap');
      var countEl = document.getElementById('post-view-count');
      if (!slug || !wrap) return;

      var CF_DOMAIN = 'https://ymrnablkm-github-io.pages.dev';
      var isGitHubPages = location.hostname.indexOf('github.io') !== -1;
      var apiBase = isGitHubPages ? CF_DOMAIN : '';
      var withCred = isGitHubPages;

      function apiUrl(path) { return apiBase + path; }
      var credOpts = withCred ? { credentials: 'include' } : {};
      var postOpts = Object.assign({ method: 'POST' }, credOpts);
      var cacheKey = 'ay_views_' + slug;

      // 1) 先从 localStorage 读取，立即显示（零延迟）
      try {
        var cached = parseInt(localStorage.getItem(cacheKey) || '0', 10);
        if (cached > 0) {
          countEl.textContent = String(cached);
          wrap.classList.remove('hidden');
        }
      } catch (e) {}

      // 2) 异步 GET 拉取最新值，覆盖显示 + 回写缓存
      fetch(apiUrl('/api/views/' + encodeURIComponent(slug)), credOpts)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && typeof data.views === 'number') {
            countEl.textContent = String(data.views);
            wrap.classList.remove('hidden');
            try { localStorage.setItem(cacheKey, String(data.views)); } catch (e) {}
          }
        })
        .catch(function () { /* 静默失败 */ });

      // 3) 异步 POST 记录浏览
      var sessionKey = 'ay_viewed_' + slug;
      if (!sessionStorage.getItem(sessionKey)) {
        sessionStorage.setItem(sessionKey, '1');
        fetch(apiUrl('/api/views/' + encodeURIComponent(slug)), postOpts)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data && typeof data.views === 'number') {
              countEl.textContent = String(data.views);
              wrap.classList.remove('hidden');
              try { localStorage.setItem(cacheKey, String(data.views)); } catch (e) {}
            }
          })
          .catch(function () { /* 静默失败 */ });
      }
    })();
  </script>
</Layout>

<style>
  .badge-pin {
    display: inline-block;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(245, 63, 63, 0.1);
    color: #f53f3f;
    margin-bottom: 8px;
  }
</style>
