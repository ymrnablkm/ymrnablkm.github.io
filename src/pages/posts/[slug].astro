---
import Layout from '../../layouts/Layout.astro';
import { getPostById, getPosts } from '../../data/posts';

export async function getStaticPaths() {
  const posts = getPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = getPosts().filter(p => p.id !== post.id);
const relatedPosts = allPosts
  .filter(p => 
    p.category === post.category || 
    p.tags.some(tag => post.tags.includes(tag))
  )
  .slice(0, 3);
---

<Layout title={post.title} description={post.description}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <span class="inline-block px-3 py-1 text-sm font-medium bg-primary/10 text-primary rounded-full mb-4">
        {post.category}
      </span>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">{post.title}</h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg">{post.description}</p>
      <div class="flex items-center gap-4 mt-4 text-sm text-gray-500">
        <span>{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
        {post.updatedDate && (
          <span>更新于 {new Date(post.updatedDate).toLocaleDateString('zh-CN')}</span>
        )}
      </div>
      <div class="flex items-center gap-2 mt-4">
        {post.tags.map(tag => (
          <span key={tag} class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 rounded">
            #{tag}
          </span>
        ))}
      </div>
    </header>
    
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <div class="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">
        {post.content}
      </div>
    </div>
    
    {relatedPosts.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-semibold mb-4">相关推荐</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedPosts.map(related => (
            <article key={related.id} class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-md transition-shadow">
              <h3 class="font-semibold mb-1">
                <a href={`/posts/${related.id}`} class="hover:text-primary transition-colors">
                  {related.title}
                </a>
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{related.description}</p>
              <span class="text-xs text-gray-400">{new Date(related.pubDate).toLocaleDateString('zh-CN')}</span>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
