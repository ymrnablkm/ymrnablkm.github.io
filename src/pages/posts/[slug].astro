---
import Layout from '../../layouts/Layout.astro';
import { getPostById, getPosts } from '../../data/posts';

export async function getStaticPaths() {
  const posts = getPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = getPosts().filter(p => p.id !== post.id);
const relatedPosts = allPosts
  .filter(p => 
    p.category === post.category || 
    p.tags.some(tag => post.tags.includes(tag))
  )
  .slice(0, 3);
---

<Layout title={post.title} description={post.description}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <span class="inline-block px-3 py-1 text-xs font-medium text-primary bg-primary/10 rounded-[4px] mb-4">
        {post.category}
      </span>
      <h1 class="text-2xl sm:text-3xl font-semibold text-text-title mb-3">
        {post.title}
      </h1>
      <p class="text-base text-text-body leading-relaxed">{post.description}</p>
      <div class="flex items-center gap-4 mt-4 text-sm text-text-muted">
        <span>{new Date(post.pubDate).toLocaleDateString('zh-CN')}</span>
        {post.updatedDate && (
          <span>更新于 {new Date(post.updatedDate).toLocaleDateString('zh-CN')}</span>
        )}
      </div>
      <div class="flex items-center gap-2 mt-4">
        {post.tags.map(tag => (
          <span key={tag} class="px-2.5 py-1 text-xs bg-border/50 text-text-muted rounded-[4px]">
            #{tag}
          </span>
        ))}
      </div>
    </header>
    
    <div class="bg-card border border-border rounded-[8px] p-6 sm:p-8">
      <div class="text-text-body leading-relaxed whitespace-pre-line">
        {post.content}
      </div>
    </div>
    
    {relatedPosts.length > 0 && (
      <section class="mt-10">
        <h2 class="text-base font-semibold text-text-title mb-4">相关推荐</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedPosts.map(related => (
            <article key={related.id} class="bg-card border border-border rounded-[8px] p-4 card-hover">
              <span class="inline-block px-2 py-0.5 text-xs text-primary bg-primary/10 rounded-[4px] mb-2">
                {related.category}
              </span>
              <h3 class="font-semibold text-text-title mb-1.5">
                <a href={`/posts/${related.id}`} class="hover:text-primary transition-colors">
                  {related.title}
                </a>
              </h3>
              <p class="text-sm text-text-body line-clamp-2">{related.description}</p>
              <span class="text-xs text-text-muted mt-2 block">
                {new Date(related.pubDate).toLocaleDateString('zh-CN')}
              </span>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
