---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, categoryBySlug, site } from '../../lib/site';

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    if (Boolean(a.data.pinned) !== Boolean(b.data.pinned)) return a.data.pinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const grouped = categories.map((category) => ({
  category,
  posts: allPosts.filter((post) => post.data.category === category.slug),
}));

const uncategorized = allPosts.filter(
  (post) => !post.data.category || !categoryBySlug(post.data.category)
);
---

<Layout title="全部文章" description={`${site.name} 的全部文章列表`}>
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-text-primary dark:text-[#E5E6EB] mb-2">全部文章</h1>
    <p class="text-sm text-text-muted dark:text-[#666666]">共 {allPosts.length} 篇已发布文章</p>
  </header>

  {allPosts.length === 0 && (
    <div class="text-center py-24 text-text-muted dark:text-[#666666]">
      <div class="text-6xl mb-4">📝</div>
      <p>还没有文章</p>
    </div>
  )}

  <div class="space-y-10">
    {grouped
      .filter((group) => group.posts.length > 0)
      .map((group) => (
        <section>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB]">
              {group.category.icon} {group.category.name}
            </h2>
            <a href={`/category/${group.category.slug}`} class="text-sm text-primary hover:underline">
              查看分类 →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {group.posts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ))}

    {uncategorized.length > 0 && (
      <section>
        <h2 class="text-xl font-semibold text-text-primary dark:text-[#E5E6EB] mb-4">未分类</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {uncategorized.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
