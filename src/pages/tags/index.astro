---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 获取所有标签及其文章数量
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const tags = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));
---

<Layout title="标签云">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold text-text-primary dark:text-[#E5E6EB] mb-3">🏷️ 标签云</h1>
    <p class="text-text-muted dark:text-[#666666]">通过标签快速找到感兴趣的内容</p>
  </div>

  <!-- 标签云 -->
  <div class="flex flex-wrap justify-center gap-3 mb-12 max-w-3xl mx-auto">
    {tags.map(tag => {
      const size = tag.count > 3 ? 'text-xl px-6 py-3' : tag.count > 1 ? 'text-base px-5 py-2.5' : 'text-sm px-4 py-2';
      return (
        <a href={`/tags/${encodeURIComponent(tag.name)}`} class={`${size} bg-surface-card dark:bg-[#1E1E1E] border border-surface-border dark:border-[#333333] rounded-full text-text-primary dark:text-[#E5E6EB] hover:text-primary hover:border-primary transition-all`}>
          #{tag.name} <span class="text-text-muted dark:text-[#666666] ml-1">({tag.count})</span>
        </a>
      );
    })}
  </div>
</Layout>
