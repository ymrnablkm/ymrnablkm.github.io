---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 404 页面上给出几篇最新文章，避免访客走进死胡同（仅在构建期读取已发布文章）
const latest = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.offline)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<Layout title="页面不存在" description="你访问的页面不存在或已经被移除。" noindex>
  <div class="text-center py-16">
    <h1 class="text-6xl font-bold text-primary mb-4">404</h1>
    <p class="text-lg text-text-secondary dark:text-[#A6A6A6] mb-8">抱歉，你访问的页面不存在或已经被移除。</p>

    <form action="/posts/" method="get" class="flex items-center justify-center gap-2 max-w-md mx-auto mb-8">
      <input
        type="search"
        name="q"
        placeholder="搜索文章标题或内容…"
        class="flex-1 min-w-0 px-4 py-2.5 rounded-lg border border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E] text-sm text-text-primary dark:text-[#E5E6EB] focus:outline-none focus:border-primary"
      />
      <button type="submit" class="px-4 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:bg-primary-dark transition-colors">
        搜索
      </button>
    </form>

    <a href="/" class="inline-block px-6 py-3 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors">
      ← 返回首页
    </a>

    {latest.length > 0 && (
      <div class="mt-12 max-w-md mx-auto text-left">
        <h2 class="text-sm font-semibold text-text-primary dark:text-[#E5E6EB] mb-3">最新文章</h2>
        <div class="rounded-card border border-surface-border dark:border-[#333333] bg-surface-card dark:bg-[#1E1E1E] divide-y divide-[#F2F3F5] dark:divide-[#333333]">
          {latest.map((post) => (
            <a href={`/posts/${encodeURIComponent(post.id)}`} class="block px-4 py-3 text-sm text-text-secondary dark:text-[#A6A6A6] hover:text-primary transition-colors">
              {post.data.title}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
