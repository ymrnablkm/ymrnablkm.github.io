---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-primary mb-4">404</h1>
    <p class="text-lg text-text-secondary dark:text-[#A6A6A6] mb-8">
      抱歉，你访问的页面不存在
    </p>
    <a href="/" class="inline-block px-6 py-3 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors">
      ← 返回首页
    </a>
  </div>
</Layout>
