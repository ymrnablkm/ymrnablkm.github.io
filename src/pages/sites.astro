---
import Layout from '../layouts/Layout.astro';
import { sites, getCategories } from '../data/sites';

const siteCategories = getCategories();
---

<Layout title="外站导航" description="收集整理的优质外部资源网站">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="text-center mb-10">
      <h1 class="text-2xl font-bold text-text-title mb-3">外站导航</h1>
      <p class="text-text-muted">收集整理的优质外部资源网站，帮助你发现更多有用的工具和学习资源</p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-3 mb-8">
      <button 
        id="allBtn"
        class="px-5 py-2.5 bg-primary text-white text-sm font-medium rounded-lg transition-all hover:shadow-lg hover:shadow-primary/30"
      >
        全部 ({sites.length})
      </button>
      {siteCategories.map(category => (
        <button 
          key={category.name}
          class="px-5 py-2.5 bg-bg-card border border-border text-text-body text-sm font-medium rounded-lg hover:bg-bg-sidebar transition-all"
        >
          {category.name} ({sites.filter(s => s.category === category.name).length})
        </button>
      ))}
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {sites.map((site, index) => (
        <a 
          key={index}
          href={site.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-bg-card border border-border rounded-xl p-5 card-hover group"
        >
          <div class="flex items-start gap-3">
            <div class="w-12 h-12 rounded-xl bg-bg-main flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              {site.icon ? (
                <img 
                  src={site.icon} 
                  alt={site.name} 
                  class="w-7 h-7 object-contain"
                  loading="lazy"
                />
              ) : (
                <span class="text-2xl">🌐</span>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-text-title mb-1.5 group-hover:text-primary transition-colors truncate">
                {site.name}
              </h3>
              <p class="text-sm text-text-body line-clamp-2 mb-2">{site.description}</p>
              <span class="inline-block px-2.5 py-1 text-xs bg-primary/10 text-primary rounded-full">
                {site.category}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
  
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('button');
      const siteCards = document.querySelectorAll('a[target="_blank"]');
      
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('bg-primary', 'text-white');
            b.classList.add('bg-bg-card', 'border', 'border-border', 'text-text-body');
          });
          btn.classList.remove('bg-bg-card', 'border', 'border-border', 'text-text-body');
          btn.classList.add('bg-primary', 'text-white');
          
          const filter = btn.textContent.split(' ')[0];
          
          siteCards.forEach(card => {
            const category = card.querySelector('span:last-child').textContent;
            if (filter === '全部' || filter === category) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>
