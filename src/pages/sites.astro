---
import Layout from '../layouts/Layout.astro';
import { sites, getCategories } from '../data/sites';

const siteCategories = getCategories();
---

<Layout title="外站导航" description="收集整理的优质外部资源网站">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Header -->
    <div class="text-center mb-12 animate-fade-in-up">
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">🔗 外站导航</h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        收集整理的优质外部资源网站，帮助你发现更多有用的工具和学习资源
      </p>
    </div>
    
    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-3 mb-10 animate-fade-in-up" style="animation-delay: 0.1s;">
      <button 
        id="allBtn"
        class="btn btn-primary"
      >
        全部 ({sites.length})
      </button>
      {siteCategories.map(category => (
        <button 
          key={category.name}
          class="px-5 py-2.5 rounded-lg bg-bg-card border border-border text-text-secondary hover:border-primary hover:text-primary transition-all text-sm font-medium"
        >
          {category.name} ({sites.filter(s => s.category === category.name).length})
        </button>
      ))}
    </div>
    
    <!-- Sites Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 animate-stagger">
      {sites.map((site, index) => (
        <a 
          key={index}
          href={site.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="card card-glow p-6 group"
        >
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-bg-elevated to-bg-card flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              {site.icon ? (
                <img 
                  src={site.icon} 
                  alt={site.name} 
                  class="w-8 h-8 object-contain"
                  loading="lazy"
                />
              ) : (
                <span>🌐</span>
              )}
            </div>
            
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-text-primary mb-1.5 group-hover:text-primary transition-colors">
                {site.name}
              </h3>
              <p class="text-sm text-text-muted line-clamp-2 mb-3">{site.description}</p>
              <span 
                class="tag text-xs"
                style="background: rgba(96, 165, 250, 0.1); color: var(--color-primary); border-color: rgba(96, 165, 250, 0.2);"
              >
                {site.category}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
  
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('button');
      const siteCards = document.querySelectorAll('a[target="_blank"]');
      
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('bg-bg-card', 'border', 'border-border', 'text-text-secondary');
          });
          btn.classList.remove('bg-bg-card', 'border', 'border-border', 'text-text-secondary');
          btn.classList.add('btn-primary');
          
          const filter = btn.textContent.split(' ')[0];
          
          siteCards.forEach(card => {
            const category = card.querySelector('span:last-child').textContent;
            if (filter === '全部' || filter === category) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>
