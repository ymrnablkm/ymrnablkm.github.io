---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const sitesData = await getCollection('sites');
const sites = sitesData.flatMap(site => site.data);

// 获取分类
const categories = [...new Set(sites.map(site => site.category))];
---

<Layout title="外站导航">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold text-text-primary dark:text-[#E5E6EB] mb-3">🔗 外站导航</h1>
    <p class="text-text-muted dark:text-[#666666]">收集整理的优质外部资源网站</p>
  </div>
  
  <!-- 搜索框 -->
  <div class="max-w-md mx-auto mb-8">
    <input 
      id="siteSearch"
      type="text" 
      placeholder="搜索网站名称或简介..." 
      class="w-full px-4 py-3 bg-surface-card dark:bg-[#1E1E1E] border border-surface-border dark:border-[#333333] rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-text-primary dark:text-[#E5E6EB]"
    />
  </div>
  
  <!-- 分类筛选 -->
  <div class="flex flex-wrap justify-center gap-2 mb-10">
    <button data-category="全部" class="site-filter-btn active px-5 py-2 bg-primary text-white text-sm font-medium rounded-lg transition-all">
      全部 ({sites.length})
    </button>
    {categories.map(cat => (
      <button data-category={cat} class="site-filter-btn px-5 py-2 bg-surface-card dark:bg-[#1E1E1E] text-text-secondary dark:text-[#A6A6A6] text-sm font-medium rounded-lg hover:bg-surface-border dark:hover:bg-[#333333] transition-all">
        {cat} ({sites.filter(s => s.category === cat).length})
      </button>
    ))}
  </div>
  
  <!-- 网站卡片 -->
  <div id="sitesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    {sites.map((site, index) => (
      <a 
        key={index}
        href={site.url}
        target="_blank"
        rel="noopener noreferrer"
        data-category={site.category}
        data-name={site.name.toLowerCase()}
        data-desc={site.description.toLowerCase()}
        class="site-card card-hover bg-surface-card dark:bg-[#1E1E1E] rounded-card border border-surface-border dark:border-[#333333] p-5 group"
      >
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-surface-border dark:bg-[#333333] rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
            {site.icon ? (
              <img src={site.icon} alt={site.name} class="w-8 h-8 object-contain" loading="lazy" />
            ) : (
              <span class="text-2xl">🌐</span>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-text-primary dark:text-[#E5E6EB] mb-1 group-hover:text-primary transition-colors truncate">
              {site.name}
            </h3>
            <p class="text-sm text-text-secondary dark:text-[#A6A6A6] line-clamp-2 mb-2">{site.description}</p>
            <span class="tag text-xs">{site.category}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>

<script is:inline>
  // 分类筛选
  document.querySelectorAll('.site-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // 更新按钮状态
      document.querySelectorAll('.site-filter-btn').forEach(b => {
        b.classList.remove('active', 'bg-primary', 'text-white');
        b.classList.add('bg-surface-card', 'dark:bg-[#1E1E1E]', 'text-text-secondary', 'dark:text-[#A6A6A6]');
      });
      btn.classList.add('active', 'bg-primary', 'text-white');
      btn.classList.remove('bg-surface-card', 'dark:bg-[#1E1E1E]', 'text-text-secondary', 'dark:text-[#A6A6A6]');
      
      // 筛选网站
      const category = btn.dataset.category;
      document.querySelectorAll('.site-card').forEach(card => {
        if (category === '全部' || card.dataset.category === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
  
  // 搜索功能
  document.getElementById('siteSearch')?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    document.querySelectorAll('.site-card').forEach(card => {
      const name = card.dataset.name || '';
      const desc = card.dataset.desc || '';
      if (query === '' || name.includes(query) || desc.includes(query)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  });
</script>