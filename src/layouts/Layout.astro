---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  date?: string;
  keywords?: string[];
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.seo.description || site.description,
  image = site.seo.ogImage || site.defaultCover || site.logo,
  type = 'website',
  date,
  keywords = site.seo.keywords || [],
  canonical,
  noindex = false,
} = Astro.props;

const siteName = site.name;
const base = site.domain || Astro.url.origin;
const canonicalUrl = canonical || `${base.replace(/\/$/, '')}${Astro.url.pathname}`;
const absoluteImage = image?.startsWith('http') ? image : `${base.replace(/\/$/, '')}${image}`;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var html = document.documentElement;
        var savedTheme = localStorage.getItem('theme');
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
          html.classList.add('dark');
        }
      })();
    </script>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#165DFF" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {date && <meta property="article:published_time" content={date} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    <title>{title} | {siteName}</title>
    <link rel="icon" href={site.icon || site.logo} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- 结构化数据 -->
    {type === 'article' && date && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        datePublished: date,
        url: canonicalUrl,
        image: absoluteImage,
        author: {
          '@type': 'Organization',
          name: siteName,
        },
        publisher: {
          '@type': 'Organization',
          name: siteName,
        },
      })} />
    )}
    {type === 'website' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        description: description,
        url: canonicalUrl,
      })} />
    )}

    <!-- 预连接 DNS -->
    <link rel="dns-prefetch" href="https://unpkg.com" />
  </head>
  <body class="bg-white dark:bg-[#121212] text-text-primary dark:text-[#E5E6EB] min-h-screen">
    <Navbar />
    <main class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-12">
      <slot />
    </main>
    <Footer />

    <!-- 回到顶部按钮 -->
    <button
      id="backToTop"
      class="back-to-top fixed bottom-6 right-6 w-12 h-12 bg-primary text-white rounded-full shadow-lg flex items-center justify-center z-50 hover:bg-primary-dark"
      aria-label="回到顶部"
    >
      <svg class="w-5 h-5 text-[#121212] dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <!-- 主题切换 & 回到顶部脚本 -->
    <script>
      const themeToggles = [
        document.getElementById('themeToggle'),
        document.getElementById('themeToggleMobile'),
      ];
      const html = document.documentElement;
      const updateThemeButtons = () => {
        const dark = html.classList.contains('dark');
        themeToggles.forEach((toggle) => {
          if (!toggle) return;
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('title', dark ? '切换到白天模式' : '切换到深色模式');
        });
      };

      updateThemeButtons();
      themeToggles.forEach((toggle) => {
        toggle?.addEventListener('click', () => {
          html.classList.toggle('dark');
          localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
          updateThemeButtons();
        });
      });

      const backToTop = document.getElementById('backToTop');

      // 滚动监听按帧节流，避免每个 scroll 事件都做 DOM 读写
      let scrollQueued = false;
      window.addEventListener('scroll', () => {
        if (scrollQueued) return;
        scrollQueued = true;
        requestAnimationFrame(() => {
          scrollQueued = false;
          if (window.scrollY > 500) {
            backToTop?.classList.add('visible');
          } else {
            backToTop?.classList.remove('visible');
          }
        });
      }, { passive: true });

      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>

    <!-- 文章卡片浏览量批量加载：localStorage 即时显示 + 后台异步批量拉取 -->
    <script is:inline>
    (function () {
      var cards = document.querySelectorAll('[data-card-slug]');
      if (!cards.length) return;

      var CF_DOMAIN = 'https://ymrnablkm-github-io.pages.dev';
      var isGitHubPages = location.hostname.indexOf('github.io') !== -1;
      var apiBase = isGitHubPages ? CF_DOMAIN : '';
      var credOpts = isGitHubPages ? { credentials: 'include' } : {};

      // 0) 先从 localStorage 批量读取所有卡片，立即显示（零延迟）
      var slugs = [];
      cards.forEach(function (el) {
        var slug = el.getAttribute('data-card-slug');
        if (slug && slugs.indexOf(slug) === -1) slugs.push(slug);
        try {
          var cached = parseInt(localStorage.getItem('ay_views_' + slug) || '0', 10);
          if (cached > 0) {
            var num = el.querySelector('.card-view-num');
            if (num) num.textContent = formatViews(cached);
            el.classList.remove('hidden');
          }
        } catch (e) {}
      });

      if (!slugs.length) return;

      // 1) 批量 GET 拉取最新值（已显示 localStorage 的会被覆盖为真实值）
      Promise.all(slugs.map(function (slug) {
        return fetch(apiBase + '/api/views/' + encodeURIComponent(slug), credOpts)
          .then(function (r) { return r.json(); })
          .then(function (d) { return { slug: slug, views: d && typeof d.views === 'number' ? d.views : null }; })
          .catch(function () { return { slug: slug, views: null }; });
      })).then(function (results) {
        results.forEach(function (r) {
          if (r.views === null) return;
          var els = document.querySelectorAll('[data-card-slug="' + r.slug + '"]');
          els.forEach(function (el) {
            var num = el.querySelector('.card-view-num');
            if (num) num.textContent = formatViews(r.views);
            el.classList.remove('hidden');
          });
          try { localStorage.setItem('ay_views_' + r.slug, String(r.views)); } catch (e) {}
        });
      });

      function formatViews(n) {
        if (n >= 10000) return (n / 10000).toFixed(1).replace(/\.0$/, '') + 'w';
        if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
        return String(n);
      }
    })();
    </script>
  </body>
</html>
